<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:groupSizing="clr-namespace:AvaloniaUI.ViewModels.GroupSizing"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaUI.Views.GroupSizing.GroupSizingView"
             x:DataType="groupSizing:GroupSizingViewModel">

    <Design.DataContext>
        <groupSizing:GroupSizingViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.modeCard">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.modeCard.inactive">
            <Setter Property="Opacity" Value="0.25" />
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        </Style>
        <Style Selector="RadioButton.modeHeader">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="RadioButton.modeHeader /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
        <Style Selector="RadioButton.modeHeader /template/ Grid > Border:first-child">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,-2,0,0" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="12" RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <Button Content="Back"
                    HorizontalAlignment="Left"
                    Cursor="Hand"
                    Command="{Binding BackCommand}" />
            <Button Grid.Column="1"
                    Content="Next"
                    HorizontalAlignment="Right"
                    Cursor="Hand"
                    Command="{Binding NextCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
            <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding StudentCount, StringFormat={}{0} students}"
                           FontSize="16"
                           FontWeight="SemiBold" />

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="24"
                      HorizontalAlignment="Stretch">
                    <StackPanel Grid.Column="0" Spacing="8">
                        <RadioButton Classes="modeHeader"
                                     Content="Use group size priorities"
                                     IsChecked="{Binding IsPriorityMode}"
                                     GroupName="GroupSizingMode"
                                     HorizontalAlignment="Center"
                                     FontSize="18"
                                     FontWeight="SemiBold" />

                        <Border Classes="modeCard"
                                Classes.inactive="{Binding IsManualMode}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1"
                                Padding="16">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="8"
                                            IsEnabled="{Binding IsPriorityMode}">
                                    <TextBlock Text="Group size priorities (comma-separated)"
                                               FontSize="14" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0"
                                                 MinHeight="32"
                                                 Text="{Binding PriorityInput}"
                                                 PlaceholderText="e.g. 4, 3, 5" />
                                        <Button Grid.Column="1"
                                                Content="Calculate"
                                                MinHeight="32"
                                                Margin="8,0,0,0"
                                                Cursor="Hand"
                                                Command="{Binding CalculateCommand}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Spacing="8"
                                            IsEnabled="{Binding IsPriorityMode}"
                                            IsVisible="{Binding CalculatedResultText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                                    <TextBlock Text="Suggested distribution"
                                               FontSize="14" />
                                    <TextBlock Text="{Binding CalculatedResultText}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="8">
                        <RadioButton Classes="modeHeader"
                                     Content="Enter specific group sizes"
                                     IsChecked="{Binding IsManualMode}"
                                     GroupName="GroupSizingMode"
                                     HorizontalAlignment="Center"
                                     FontSize="18"
                                     FontWeight="SemiBold" />

                        <Border Classes="modeCard"
                                Classes.inactive="{Binding IsPriorityMode}"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1"
                                Padding="16">
                            <StackPanel Spacing="8"
                                        IsEnabled="{Binding IsManualMode}">
                                <TextBlock Text="Group sizes (comma-separated)"
                                           FontSize="14" />
                                <TextBox Text="{Binding ManualSizesInput}"
                                         MinHeight="32"
                                         PlaceholderText="e.g. 4, 4, 3, 3" />
                                <TextBlock Text="The sum must equal the number of students."
                                           FontSize="14"
                                           Opacity="0.8"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,0"
                   Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
    </Grid>

</UserControl>
