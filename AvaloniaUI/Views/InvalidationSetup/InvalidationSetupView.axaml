<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:invalidationSetup="clr-namespace:AvaloniaUI.ViewModels.InvalidationSetup"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaUI.Views.InvalidationSetup.InvalidationSetupView"
             x:DataType="invalidationSetup:InvalidationSetupViewModel">

    <Design.DataContext>
        <invalidationSetup:InvalidationSetupViewModel />
    </Design.DataContext>

    <Grid Margin="12" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <Button Content="Back"
                    HorizontalAlignment="Left"
                    Command="{Binding BackCommand}" />
            <Button Grid.Column="1"
                    Content="Next"
                    HorizontalAlignment="Right"
                    Command="{Binding NextCommand}" />
        </Grid>
    </Grid>
</UserControl>
