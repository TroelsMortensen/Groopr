<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:generation="clr-namespace:AvaloniaUI.ViewModels.GroupCompositionGeneration"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaUI.Views.GroupCompositionGeneration.GroupCompositionGenerationView"
             x:DataType="generation:GroupCompositionGenerationViewModel">

    <Design.DataContext>
        <generation:GroupCompositionGenerationViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.compositionCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style Selector="Border.titlePill">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <Button Content="Back"
                    HorizontalAlignment="Left"
                    Command="{Binding BackCommand}" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="{Binding PolishButtonText}"
                        Command="{Binding TogglePolishCommand}" />
                <Button Content="{Binding GenerationButtonText}"
                        Command="{Binding ToggleGenerationCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="4">
            <TextBlock FontSize="14"
                       Text="{Binding GeneratedCount, StringFormat=Generated: {0:N0}}" />
            <TextBlock FontSize="14"
                       Text="{Binding PolishedCount, StringFormat=Polished: {0:N0}}" />
            <TextBlock FontSize="14"
                       Text="{Binding DuplicateRejectedCount, StringFormat=Duplicates rejected: {0:N0}}" />
            <StackPanel Spacing="2"
                        IsVisible="{Binding HasRecentInsertions}">
                <TextBlock FontSize="14"
                           Text="Recent top-5 insertions:" />
                <ItemsControl ItemsSource="{Binding RecentTopCompositionInsertedTexts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock FontSize="14"
                                       Text="{Binding}"
                                       Margin="12,0,0,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding TopCompositions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="generation:GroupCompositionCardViewModel">
                        <Border Classes="compositionCard"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1"
                                Padding="16,20,16,16">
                            <StackPanel Spacing="12">
                                <Border Classes="titlePill"
                                        Margin="0,-28,0,0">
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{Binding ScoreText, StringFormat=Score: {0}}" />
                                </Border>

                                <SelectableTextBlock Text="{Binding PlainText}"
                                                     FontSize="14"
                                                     TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</UserControl>
