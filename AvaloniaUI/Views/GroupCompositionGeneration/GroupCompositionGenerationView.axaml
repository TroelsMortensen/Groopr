<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:generation="clr-namespace:AvaloniaUI.ViewModels.GroupCompositionGeneration"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaUI.Views.GroupCompositionGeneration.GroupCompositionGenerationView"
             x:DataType="generation:GroupCompositionGenerationViewModel">

    <Design.DataContext>
        <generation:GroupCompositionGenerationViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.compositionCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style Selector="Border.titlePill">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <Button Content="Back"
                    HorizontalAlignment="Left"
                    Command="{Binding BackCommand}" />
            <Button Grid.Column="1"
                    Content="{Binding GenerationButtonText}"
                    HorizontalAlignment="Right"
                    Command="{Binding ToggleGenerationCommand}" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="4">
            <TextBlock FontSize="14"
                       Text="{Binding GeneratedCount, StringFormat=Generated: {0:N0}}" />
            <TextBlock FontSize="14"
                       Text="{Binding DuplicateRejectedCount, StringFormat=Duplicates rejected: {0:N0}}" />
            <TextBlock FontSize="14"
                       Text="{Binding LastTopCompositionInsertedText, StringFormat=Last top-5 insertion: {0}}"
                       IsVisible="{Binding LastTopCompositionInsertedText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding TopCompositions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="generation:GroupCompositionCardViewModel">
                        <Border Classes="compositionCard"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1"
                                Padding="16,20,16,16">
                            <StackPanel Spacing="12">
                                <Border Classes="titlePill"
                                        Margin="0,-28,0,0">
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Text="{Binding ScoreText, StringFormat=Score: {0}}" />
                                </Border>

                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="generation:GroupCardViewModel">
                                            <StackPanel Spacing="4" Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           FontSize="14" />
                                                <ItemsControl ItemsSource="{Binding Members}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="generation:GroupMemberViewModel">
                                                            <TextBlock Text="{Binding DisplayText, StringFormat=- {0}}"
                                                                       FontSize="14"
                                                                       Margin="12,0,0,0" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</UserControl>
