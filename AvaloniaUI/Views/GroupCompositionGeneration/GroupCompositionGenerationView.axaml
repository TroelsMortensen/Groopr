<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:generation="clr-namespace:AvaloniaUI.ViewModels.GroupCompositionGeneration"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaUI.Views.GroupCompositionGeneration.GroupCompositionGenerationView"
             x:DataType="generation:GroupCompositionGenerationViewModel"
             x:Name="Root">

    <Design.DataContext>
        <generation:GroupCompositionGenerationViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.compositionCard">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style Selector="Border.titlePill">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.copyPill">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.copyPill /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="Button.copyPill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
        </Style>
        <Style Selector="Button.copyPill:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAltHighBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <Button Content="Back"
                    HorizontalAlignment="Left"
                    Cursor="Hand"
                    Command="{Binding BackCommand}" />
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="8">
                <Button Content="{Binding PolishButtonText}"
                        Cursor="Hand"
                        Command="{Binding TogglePolishCommand}" />
                <Button Content="{Binding GenerationButtonText}"
                        Cursor="Hand"
                        Command="{Binding ToggleGenerationCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="4">
            <TextBlock FontSize="14"
                       Text="{Binding GeneratedCount, StringFormat=Generated: {0:N0}}" />
            <TextBlock FontSize="14"
                       Text="{Binding PolishedCount, StringFormat=Polished: {0:N0}}" />
            <TextBlock FontSize="14"
                       Text="{Binding DuplicateRejectedCount, StringFormat=Duplicates rejected: {0:N0}}" />
            <StackPanel Spacing="2"
                        IsVisible="{Binding HasRecentInsertions}">
                <TextBlock FontSize="14"
                           Text="Recent top-5 insertions:" />
                <ItemsControl ItemsSource="{Binding RecentTopCompositionInsertedTexts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock FontSize="14"
                                       Text="{Binding}"
                                       Margin="12,0,0,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="2" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding TopCompositions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="generation:GroupCompositionCardViewModel">
                        <Border Classes="compositionCard"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1"
                                Padding="16,20,16,16">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8"
                                            Margin="0,-28,0,0"
                                            HorizontalAlignment="Left">
                                    <Border Classes="titlePill"
                                            VerticalAlignment="Center">
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ScoreText, StringFormat=Score: {0}}" />
                                    </Border>
                                    <Button Classes="copyPill"
                                            Command="{Binding #Root.((generation:GroupCompositionGenerationViewModel)DataContext).CopyCompositionCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Copy"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <PathIcon Width="14"
                                                      Height="14"
                                                      VerticalAlignment="Center"
                                                      Data="M16,1H4C2.9,1 2,1.9 2,3V17H4V3H16V1M19,5H8C6.9,5 6,5.9 6,7V21C6,22.1 6.9,23 8,23H19C20.1,23 21,22.1 21,21V7C21,5.9 20.1,5 19,5M19,21H8V7H19V21Z" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Text="Copied"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding ShowCopiedFeedback}" />
                                </StackPanel>

                                <SelectableTextBlock Text="{Binding PlainText}"
                                                     FontSize="14"
                                                     TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</UserControl>
