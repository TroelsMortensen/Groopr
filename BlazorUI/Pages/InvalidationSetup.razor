@page "/invalidation-setup"

<div class="page-frame">
    <div class="page-toolbar">
        <button type="button" class="btn" @onclick="Back">Back</button>
        <button type="button" class="btn btn-primary" @onclick="Next">Next</button>
    </div>

    <div class="page-body">
        <h2 class="section-heading">Invalidation rules</h2>
        <div class="rule-grid">
            @foreach (var card in InvalidatorCards)
            {
                <InvalidatorRuleCard Card="card" OnChanged="StateHasChanged" />
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <div class="page-status">@StatusMessage</div>
    }
</div>
